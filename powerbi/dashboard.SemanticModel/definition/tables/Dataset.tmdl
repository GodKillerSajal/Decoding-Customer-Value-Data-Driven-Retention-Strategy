table Dataset
	lineageTag: 1b95986c-d716-4fcb-897a-c5cdf64f80c1

	measure 'Total Customers' = COUNTROWS(Dataset)
		formatString: #,0
		lineageTag: a1000000-0000-0000-0000-000000000001

	measure 'Total Revenue' = SUM(Dataset[Purchase Amount (USD)])
		formatString: \$#,0
		lineageTag: a1000000-0000-0000-0000-000000000002

	measure 'Avg Purchase Amount' = AVERAGE(Dataset[Purchase Amount (USD)])
		formatString: \$#,0.00
		lineageTag: a1000000-0000-0000-0000-000000000003

	measure 'Avg Review Rating' = AVERAGE(Dataset[Review Rating])
		formatString: 0.00
		lineageTag: a1000000-0000-0000-0000-000000000004

	measure 'Avg Previous Purchases' = AVERAGE(Dataset[Previous Purchases])
		formatString: #,0.0
		lineageTag: a1000000-0000-0000-0000-000000000005

	measure 'Discount Rate %' = DIVIDE(CALCULATE(COUNTROWS(Dataset), Dataset[Discount Applied] = "Yes"), COUNTROWS(Dataset))
		formatString: 0.0%
		lineageTag: a1000000-0000-0000-0000-000000000006

	measure 'Subscriber Rate %' = DIVIDE(CALCULATE(COUNTROWS(Dataset), Dataset[Subscription Status] = "Yes"), COUNTROWS(Dataset))
		formatString: 0.0%
		lineageTag: a1000000-0000-0000-0000-000000000007

	measure 'Promo Usage Rate %' = DIVIDE(CALCULATE(COUNTROWS(Dataset), Dataset[Promo Code Used] = "Yes"), COUNTROWS(Dataset))
		formatString: 0.0%
		lineageTag: a1000000-0000-0000-0000-000000000008

	measure 'Revenue Without Discount' = CALCULATE(SUM(Dataset[Purchase Amount (USD)]), Dataset[Discount Applied] = "No")
		formatString: \$#,0
		lineageTag: a1000000-0000-0000-0000-000000000009

	measure 'Revenue With Discount' = CALCULATE(SUM(Dataset[Purchase Amount (USD)]), Dataset[Discount Applied] = "Yes")
		formatString: \$#,0
		lineageTag: a1000000-0000-0000-0000-000000000010

	measure 'Organic Revenue %' = DIVIDE(CALCULATE(SUM(Dataset[Purchase Amount (USD)]), Dataset[Discount Applied] = "No"), SUM(Dataset[Purchase Amount (USD)]))
		formatString: 0.0%
		lineageTag: a1000000-0000-0000-0000-000000000011

	measure 'Weekly-BiWeekly Buyers %' = DIVIDE(CALCULATE(COUNTROWS(Dataset), Dataset[Frequency of Purchases] IN {"Weekly","Bi-Weekly"}), COUNTROWS(Dataset))
		formatString: 0.0%
		lineageTag: a1000000-0000-0000-0000-000000000012

