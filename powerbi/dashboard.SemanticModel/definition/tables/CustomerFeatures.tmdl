table CustomerFeatures
	lineageTag: cf000000-0000-0000-0000-000000000001

	measure 'CF Total Customers' = COUNTROWS(CustomerFeatures)
		formatString: #,0
		lineageTag: cf000002-0000-0000-0000-000000000001

	measure 'CF Total Revenue' = SUM(CustomerFeatures[purchase_amount_usd])
		formatString: \$#,0
		lineageTag: cf000002-0000-0000-0000-000000000002

	measure 'CF Avg Spend' = AVERAGE(CustomerFeatures[purchase_amount_usd])
		formatString: \$#,0.00
		lineageTag: cf000002-0000-0000-0000-000000000003

	measure 'CF Avg Rating' = AVERAGE(CustomerFeatures[review_rating])
		formatString: 0.00
		lineageTag: cf000002-0000-0000-0000-000000000004

	measure 'CF Avg Prev Purchases' = AVERAGE(CustomerFeatures[previous_purchases])
		formatString: #,0.0
		lineageTag: cf000002-0000-0000-0000-000000000005

	measure 'CF Diamond Count' = CALCULATE(COUNTROWS(CustomerFeatures), CustomerFeatures[value_tier] = "Diamond")
		formatString: #,0
		lineageTag: cf000002-0000-0000-0000-000000000006

	measure 'CF Gold Count' = CALCULATE(COUNTROWS(CustomerFeatures), CustomerFeatures[value_tier] = "Gold")
		formatString: #,0
		lineageTag: cf000002-0000-0000-0000-000000000007

	measure 'CF Silver Count' = CALCULATE(COUNTROWS(CustomerFeatures), CustomerFeatures[value_tier] = "Silver")
		formatString: #,0
		lineageTag: cf000002-0000-0000-0000-000000000008

	measure 'CF Bronze Count' = CALCULATE(COUNTROWS(CustomerFeatures), CustomerFeatures[value_tier] = "Bronze")
		formatString: #,0
		lineageTag: cf000002-0000-0000-0000-000000000009

	measure 'CF Promo Dependent %' = DIVIDE(CALCULATE(COUNTROWS(CustomerFeatures), CustomerFeatures[promo_dependency_score] = 3), COUNTROWS(CustomerFeatures))
		formatString: 0.0%
		lineageTag: cf000002-0000-0000-0000-000000000010

	measure 'CF Loyalty A Rate %' = DIVIDE(CALCULATE(COUNTROWS(CustomerFeatures), CustomerFeatures[loyalty_a] = 1), COUNTROWS(CustomerFeatures))
		formatString: 0.0%
		lineageTag: cf000002-0000-0000-0000-000000000011

	measure 'CF Discount Rate %' = DIVIDE(CALCULATE(COUNTROWS(CustomerFeatures), CustomerFeatures[discount_applied] = "Yes"), COUNTROWS(CustomerFeatures))
		formatString: 0.0%
		lineageTag: cf000002-0000-0000-0000-000000000012

	measure 'CF Organic Revenue %' = DIVIDE(CALCULATE(SUM(CustomerFeatures[purchase_amount_usd]), CustomerFeatures[discount_applied] = "No"), SUM(CustomerFeatures[purchase_amount_usd]))
		formatString: 0.0%
		lineageTag: cf000002-0000-0000-0000-000000000013

	measure 'CF Avg Promo Score' = AVERAGE(CustomerFeatures[promo_dependency_score])
		formatString: 0.00
		lineageTag: cf000002-0000-0000-0000-000000000014

	measure 'CF Diamond Revenue %' = DIVIDE(CALCULATE(SUM(CustomerFeatures[purchase_amount_usd]), CustomerFeatures[value_tier] = "Diamond"), SUM(CustomerFeatures[purchase_amount_usd]))
		formatString: 0.0%
		lineageTag: cf000002-0000-0000-0000-000000000015

	measure 'CF Subscriber Rate %' = DIVIDE(CALCULATE(COUNTROWS(CustomerFeatures), CustomerFeatures[is_subscriber] = 1), COUNTROWS(CustomerFeatures))
		formatString: 0.0%
		lineageTag: cf000002-0000-0000-0000-000000000016

